  <property name="styleSheet">
   <string notr="true">/* =====================================================================
   ULDK GUGiK – styl EnviroSolutions (konwencja „GIS Assistant AI”).
   Kolory zależą od dynamicznej właściwości okna „theme” (light / dark).
   W Designerze zmień ją ręcznie, żeby podejrzeć drugi motyw (Ctrl+R).
   W QGIS ustawia ją uldk_gugik_dialog.py na podstawie motywu programu.
   Ikony w url(...) korzystają z prefiksu „uldkimg:” = katalog images/.
   ===================================================================== */

/* ---------- Struktura (wspólna dla obu motywów) ---------- */
QLabel#lbl_title { font-size: 16px; font-weight: 700; }
QLabel#lbl_subtitle, QLabel#lbl_pluginVersion { font-size: 11px; }
QToolButton#btn_help { border: none; border-radius: 6px; padding: 3px; }
QLabel#lbl_email, QLabel#lbl_szkolenia { font-size: 10px; }
QLabel#label_6 { padding: 2px 6px; border-radius: 4px; }

QFrame#groupBox { border-radius: 6px; margin: 0px; padding: 0px; }
QLabel#lbl_layers_title { font-weight: 700; padding: 6px 10px; border-top-left-radius: 5px; border-top-right-radius: 5px; }
QFrame#groupBox QRadioButton { spacing: 0px; padding: 6px 10px; border-radius: 4px; }
QFrame#groupBox QRadioButton::indicator { width: 0px; height: 0px; border: none; image: none; }
QFrame#groupBox QRadioButton:checked { font-weight: 700; }

QTabWidget::pane { border-radius: 6px; border-top-left-radius: 0px; top: -1px; }
QTabBar::tab { padding: 6px 14px; margin-right: 3px; margin-top: 3px; border-top-left-radius: 6px; border-top-right-radius: 6px; font-weight: 700; }
QTabBar::tab:selected { margin-top: 0px; padding-bottom: 7px; margin-bottom: -1px; }

QLabel[role="section"] { font-size: 13px; font-weight: 700; }
QLabel[role="field-title"] { font-weight: 700; }
QLabel[role="code"] { padding: 8px 10px; border-radius: 4px; }
QLabel[role="divider"] { font-size: 10px; padding: 0px 8px; }
QFrame#line_or_left, QFrame#line_or_right { border: none; min-height: 1px; max-height: 1px; }

QGroupBox#groupBox_2 { font-size: 13px; font-weight: 700; border-radius: 6px; margin-top: 10px; padding: 12px 10px 8px 10px; }
QGroupBox#groupBox_2::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0px 4px; }

QLineEdit, QComboBox, QAbstractSpinBox { border-radius: 4px; padding: 3px 6px; min-height: 20px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 22px; border: none; }
QComboBox::down-arrow { image: url(uldkimg:chevron_down.svg); width: 12px; height: 12px; }
QgsProjectionSelectionWidget QToolButton { border-radius: 4px; padding: 3px 6px; }

QPushButton { border-radius: 4px; padding: 5px 12px; min-height: 18px; }
QPushButton[role="primary"] { font-weight: 700; padding: 5px 16px; border: none; }

/* ---------- Motyw jasny ---------- */
QDialog[theme="light"] { background: #ffffff; }
QDialog[theme="light"] QLabel, QDialog[theme="light"] QRadioButton { color: #23282a; }
QDialog[theme="light"] QFrame#header_frame { background: #ffffff; border: none; border-bottom: 2px solid #4c6e4f; }
QDialog[theme="light"] QLabel#lbl_title { color: #3b5a3e; }
QDialog[theme="light"] QLabel#lbl_subtitle, QDialog[theme="light"] QLabel#lbl_pluginVersion { color: #6b7572; }
QDialog[theme="light"] QToolButton#btn_help:hover { background: #e8efe8; }
QDialog[theme="light"] QFrame#footer_frame { background: #f6f8f6; border: none; border-top: 1px solid #d6ded6; }
QDialog[theme="light"] QLabel#label_6 { background: transparent; }

QDialog[theme="light"] QFrame#groupBox { background: #f6f8f6; border: 1px solid #b9c7b9; }
QDialog[theme="light"] QLabel#lbl_layers_title { background: #b9c7b9; color: #23282a; }
QDialog[theme="light"] QFrame#groupBox QRadioButton { background: #ffffff; border: 1px solid #d6ded6; color: #23282a; }
QDialog[theme="light"] QFrame#groupBox QRadioButton:hover { border-color: #4c6e4f; }
QDialog[theme="light"] QFrame#groupBox QRadioButton:checked { background: #4c6e4f; border-color: #4c6e4f; color: #ffffff; }

QDialog[theme="light"] QTabWidget::pane { background: #ffffff; border: 1px solid #b9c7b9; }
QDialog[theme="light"] QWidget#tab1, QDialog[theme="light"] QWidget#tab2, QDialog[theme="light"] QWidget#tab3 { background: #ffffff; }
QDialog[theme="light"] QTabBar::tab { background: #e3ebe3; color: #5a6460; border: 1px solid #c9d5c9; border-bottom: 1px solid #b9c7b9; }
QDialog[theme="light"] QTabBar::tab:hover { background: #eef3ee; color: #3b5a3e; }
QDialog[theme="light"] QTabBar::tab:selected { background: #ffffff; color: #3b5a3e; border-color: #b9c7b9; border-bottom: 1px solid #ffffff; }

QDialog[theme="light"] QLabel[role="section"] { color: #3b5a3e; }
QDialog[theme="light"] QLabel[role="code"] { background: #eef3ee; border: 1px solid #d6ded6; color: #3b5a3e; }
QDialog[theme="light"] QLabel[role="divider"] { color: #8a948f; }
QDialog[theme="light"] QFrame#line_or_left, QDialog[theme="light"] QFrame#line_or_right { background: #d6ded6; }
QDialog[theme="light"] QGroupBox#groupBox_2 { background: #ffffff; border: 1px solid #b9c7b9; color: #3b5a3e; }

QDialog[theme="light"] QLineEdit, QDialog[theme="light"] QComboBox, QDialog[theme="light"] QAbstractSpinBox { background: #ffffff; color: #23282a; border: 1px solid #b9c7ba; selection-background-color: #4c6e4f; selection-color: #ffffff; }
QDialog[theme="light"] QLineEdit:focus, QDialog[theme="light"] QComboBox:focus, QDialog[theme="light"] QAbstractSpinBox:focus { border-color: #4c6e4f; }
QDialog[theme="light"] QLineEdit:disabled, QDialog[theme="light"] QComboBox:disabled, QDialog[theme="light"] QAbstractSpinBox:disabled { background: #f3f5f3; color: #9aa39e; border-color: #d6ded6; }
QDialog[theme="light"] QComboBox QLineEdit, QDialog[theme="light"] QAbstractSpinBox QLineEdit { border: none; padding: 0px; min-height: 0px; background: transparent; }
QDialog[theme="light"] QComboBox QAbstractItemView { background: #ffffff; color: #23282a; border: 1px solid #b9c7ba; selection-background-color: #4c6e4f; selection-color: #ffffff; }
QDialog[theme="light"] QgsProjectionSelectionWidget QToolButton { background: #ffffff; color: #23282a; border: 1px solid #b9c7ba; }

QDialog[theme="light"] QPushButton { background: #ffffff; color: #23282a; border: 1px solid #b9c7ba; }
QDialog[theme="light"] QPushButton:hover { border-color: #4c6e4f; color: #3b5a3e; }
QDialog[theme="light"] QPushButton:pressed { background: #eef3ee; }
QDialog[theme="light"] QPushButton:disabled { color: #9aa39e; border-color: #d6ded6; }
QDialog[theme="light"] QPushButton[role="primary"] { background: #4c6e4f; color: #ffffff; border: none; }
QDialog[theme="light"] QPushButton[role="primary"]:hover { background: #5b8260; color: #ffffff; }
QDialog[theme="light"] QPushButton[role="primary"]:pressed { background: #3d5a40; }
QDialog[theme="light"] QPushButton[role="primary"]:disabled { background: #c9d3ca; color: #f4f6f4; }

/* ---------- Motyw ciemny ---------- */
QDialog[theme="dark"] { background: #2b2d2e; }
QDialog[theme="dark"] QLabel, QDialog[theme="dark"] QRadioButton { color: #e6e9e7; }
QDialog[theme="dark"] QFrame#header_frame { background: #2b2d2e; border: none; border-bottom: 2px solid #5b8260; }
QDialog[theme="dark"] QLabel#lbl_title { color: #a9cfac; }
QDialog[theme="dark"] QLabel#lbl_subtitle, QDialog[theme="dark"] QLabel#lbl_pluginVersion { color: #9aa4a0; }
QDialog[theme="dark"] QToolButton#btn_help:hover { background: #2c3a2d; }
QDialog[theme="dark"] QFrame#footer_frame { background: #303334; border: none; border-top: 1px solid #44494a; }
QDialog[theme="dark"] QLabel#label_6 { background: transparent; }

QDialog[theme="dark"] QFrame#groupBox { background: #303334; border: 1px solid #4c6e4f; }
QDialog[theme="dark"] QLabel#lbl_layers_title { background: #4c6e4f; color: #ffffff; }
QDialog[theme="dark"] QFrame#groupBox QRadioButton { background: #262829; border: 1px solid #44494a; color: #e6e9e7; }
QDialog[theme="dark"] QFrame#groupBox QRadioButton:hover { border-color: #6f9c73; }
QDialog[theme="dark"] QFrame#groupBox QRadioButton:checked { background: #5b8260; border-color: #5b8260; color: #ffffff; }

QDialog[theme="dark"] QTabWidget::pane { background: #262829; border: 1px solid #4c6e4f; }
QDialog[theme="dark"] QWidget#tab1, QDialog[theme="dark"] QWidget#tab2, QDialog[theme="dark"] QWidget#tab3 { background: #262829; }
QDialog[theme="dark"] QTabBar::tab { background: #1f2122; color: #9aa4a0; border: 1px solid #3a3f40; border-bottom: 1px solid #4c6e4f; }
QDialog[theme="dark"] QTabBar::tab:hover { background: #2c3a2d; color: #e6e9e7; }
QDialog[theme="dark"] QTabBar::tab:selected { background: #262829; color: #a9cfac; border-color: #4c6e4f; border-bottom: 1px solid #262829; }

QDialog[theme="dark"] QLabel[role="section"] { color: #a9cfac; }
QDialog[theme="dark"] QLabel[role="code"] { background: #1f2a20; border: 1px solid #3d5a40; color: #cfe0d0; }
QDialog[theme="dark"] QLabel[role="divider"] { color: #8a918e; }
QDialog[theme="dark"] QFrame#line_or_left, QDialog[theme="dark"] QFrame#line_or_right { background: #44494a; }
QDialog[theme="dark"] QGroupBox#groupBox_2 { background: #262829; border: 1px solid #4c6e4f; color: #a9cfac; }

QDialog[theme="dark"] QLineEdit, QDialog[theme="dark"] QComboBox, QDialog[theme="dark"] QAbstractSpinBox { background: #1f2122; color: #e6e9e7; border: 1px solid #5a6162; selection-background-color: #5b8260; selection-color: #ffffff; }
QDialog[theme="dark"] QLineEdit:focus, QDialog[theme="dark"] QComboBox:focus, QDialog[theme="dark"] QAbstractSpinBox:focus { border-color: #6f9c73; }
QDialog[theme="dark"] QLineEdit:disabled, QDialog[theme="dark"] QComboBox:disabled, QDialog[theme="dark"] QAbstractSpinBox:disabled { background: #2b2d2e; color: #6f7773; border-color: #44494a; }
QDialog[theme="dark"] QComboBox QLineEdit, QDialog[theme="dark"] QAbstractSpinBox QLineEdit { border: none; padding: 0px; min-height: 0px; background: transparent; }
QDialog[theme="dark"] QComboBox QAbstractItemView { background: #1f2122; color: #e6e9e7; border: 1px solid #5a6162; selection-background-color: #5b8260; selection-color: #ffffff; }
QDialog[theme="dark"] QgsProjectionSelectionWidget QToolButton { background: #1f2122; color: #e6e9e7; border: 1px solid #5a6162; }

QDialog[theme="dark"] QPushButton { background: #303334; color: #e6e9e7; border: 1px solid #5a6162; }
QDialog[theme="dark"] QPushButton:hover { border-color: #6f9c73; color: #a9cfac; }
QDialog[theme="dark"] QPushButton:pressed { background: #2c3a2d; }
QDialog[theme="dark"] QPushButton:disabled { color: #6f7773; border-color: #44494a; }
QDialog[theme="dark"] QPushButton[role="primary"] { background: #5b8260; color: #ffffff; border: none; }
QDialog[theme="dark"] QPushButton[role="primary"]:hover { background: #6f9c73; color: #ffffff; }
QDialog[theme="dark"] QPushButton[role="primary"]:pressed { background: #4c6e4f; }
QDialog[theme="dark"] QPushButton[role="primary"]:disabled { background: #3e4442; color: #8a918e; }

/* ---------- Comboboxy poniżej wybranego poziomu (ustawia muted w Pythonie) ---------- */
QDialog QComboBox[muted="true"], QDialog QComboBox[muted="true"]:disabled,
QDialog QComboBox[muted="true"] QLineEdit, QDialog QComboBox[muted="true"]:disabled QLineEdit { color: transparent; }
</string>
